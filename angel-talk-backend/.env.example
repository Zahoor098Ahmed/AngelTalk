PORT=4000
NODE_ENV=development
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/angeltalk?retryWrites=true&w=majority
JWT_ACCESS_SECRET=your_jwt_access_secret_min_16_chars_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_16_chars_here
JWT_PIN_SECRET=your_jwt_pin_secret_min_16_chars_here
CORS_ORIGIN=*
ADMIN_EMAIL=admin@angeltalk.sa
ADMIN_PASSWORD=ChangeMe123!SafeAdmin
FACE_SERVER_TEMPLATES=false
ENABLE_WHISPER=false
ENABLE_IMAGE_GEN=false
AWS_REGION=me-central-1
S3_BUCKET_NAME=angel-talk-media
GOOGLE_TTS_REGION=me-central1
SMS_PROVIDER=mock

# Optional: official Google Cloud Translation key for the admin auto-translate (free services are used otherwise)
GOOGLE_TRANSLATE_API_KEY=

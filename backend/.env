# Local development. See .env.example for details. Git-ignored — put real values here.

PORT=8787

# Needed for /images/generations and /audio/transcriptions (leave blank to disable those).
OPENAI_API_KEY=

# Shared secret the app sends as "Authorization: Bearer <token>".
# Must match EXPO_PUBLIC_AI_PROXY_TOKEN in frontend/.env.
# Blank = no auth (fine for local dev on your own machine).
APP_TOKEN=

# Optional — enables Pixabay photo search server-side.
PIXABAY_KEY=

CORS_ORIGIN=*
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1024
SCENE_UPSTREAM=https://image.pollinations.ai/prompt

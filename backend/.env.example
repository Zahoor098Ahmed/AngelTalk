# Copy to .env and fill in.

# Port the API listens on
PORT=8787

# OpenAI key — used for AI image generation and Whisper speech-to-text.
# Set a hard spending limit on this key in the OpenAI dashboard.
OPENAI_API_KEY=sk-...

# Shared secret the app must send as "Authorization: Bearer <token>".
# Generate a long random string. Leave blank to disable auth (local dev only).
APP_TOKEN=

# Optional — enables the /images/search Pixabay source. ARASAAC needs no key.
PIXABAY_KEY=

# Comma-separated list of allowed origins for CORS. "*" allows all (fine for a
# mobile app which sends no Origin header anyway).
CORS_ORIGIN=*

# Image model + defaults
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1024

# Optional — free image engine behind /scene (Picture Talk AI fallback).
# Default is Pollinations; no key needed.
SCENE_UPSTREAM=https://image.pollinations.ai/prompt
